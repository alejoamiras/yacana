{
  "name": "@yacana/web-landing",
  "version": "0.0.0",
  "private": true,
  "description": "The landing at /: what YACA is, the money rules, the live hero, the recorded claim, launch mode",
  "type": "module",
  "scripts": {
    "build": "bun scripts/prebuild.ts && tsc -b && vite build",
    "dev": "bun scripts/prebuild.ts && vite",
    "og-card": "bun scripts/og-card.ts",
    "preview": "vite preview",
    "test:components": "vitest run",
    "test:e2e": "bun scripts/prebuild.ts && playwright test",
    "typecheck": "tsc -b --force"
  },
  "dependencies": {
    "@aztec-labs/aztec.js": "6.0.0",
    "@aztec-labs/foundation": "6.0.0",
    "@aztec-labs/stdlib": "6.0.0",
    "@tailwindcss/vite": "^4",
    "@yacana/bridge": "workspace:*",
    "@yacana/miner-core": "workspace:*",
    "@yacana/ui": "workspace:*",
    "@yacana/web-kit": "workspace:*",
    "@yacana/work-circuit": "workspace:*",
    "idb-keyval": "^6",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "tailwindcss": "^4"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@testing-library/jest-dom": "^6",
    "@testing-library/react": "^16",
    "@types/node": "^24",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^6",
    "@yacana/deploy": "workspace:*",
    "@yacana/localnet": "workspace:*",
    "jsdom": "^28",
    "typescript": "~6",
    "vite": "^8",
    "vite-plugin-node-polyfills": "^0.28.0",
    "vitest": "^4"
  }
