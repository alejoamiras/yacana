{
  "name": "@yacana/web-stats",
  "version": "0.0.0",
  "private": true,
  "description": "Observatory and Verify pages: the epoch history and the deployment record, read from public storage through the slot table",
  "type": "module",
  "exports": {
    "./e2e/helpers": "./e2e/helpers.ts",
    "./routes": "./src/routes.ts"
  },
  "scripts": {
    "build": "bun scripts/prebuild.ts && tsc -b && vite build",
    "dev": "bun scripts/prebuild.ts && vite",
    "preview": "vite preview",
    "test:components": "vitest run",
    "test:e2e": "bun scripts/prebuild.ts && playwright test",
    "test:visual": "bun e2e/visual.ts",
    "typecheck": "tsc -b --force"
  },
  "dependencies": {
    "@aztec/aztec.js": "5.2.0",
    "@aztec/foundation": "5.2.0",
    "@aztec/stdlib": "5.2.0",
    "@observablehq/plot": "0.6.17",
    "@tailwindcss/vite": "^4",
    "@yacana/bridge": "workspace:*",
    "@yacana/miner-core": "workspace:*",
    "@yacana/stats-view": "workspace:*",
    "@yacana/ui": "workspace:*",
    "@yacana/web-kit": "workspace:*",
    "@yacana/work-circuit": "workspace:*",
    "jotai": "^2",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "tailwindcss": "^4"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@testing-library/jest-dom": "^6",
    "@testing-library/react": "^16",
    "@types/node": "^24",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^6",
    "@yacana/deploy": "workspace:*",
    "@yacana/localnet": "workspace:*",
    "jsdom": "^28",
    "typescript": "~6",
    "vite": "^8",
    "vitest": "^4"
  }
}
