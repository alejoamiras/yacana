#[test]
fn ticket_digest_matches_miner_core() {
    assert_eq(ticket_digest(FIXTURE_PROOF), 0x12cb314d627cf48385b808837c1ca594af5820a308c1447aec7bcac0a80befbd);
}

#[test]
fn low128_matches_miner_core() {
    assert_eq(low128(0x12cb314d627cf48385b808837c1ca594af5820a308c1447aec7bcac0a80befbd), 0xaf5820a308c1447aec7bcac0a80befbd);
}

#[test]
fn deploy_domain_matches_miner_core() {
    let d = v_deploy();
    assert_eq(d, 0xe34575136650f291470482d0b212fc8ad75fa3f18ffc9af5414f6c75ca3d766);
}

fn v_deploy() -> Field {
    Poseidon2::hash(
        [
            DOM_DEPLOY,
            0x7a69,
            0x6c9467ce,
            0x1234,
            0x1,
        ],
        5,
    )
}

#[test]
fn secret_commitment_matches_miner_core() {
    let c = Poseidon2::hash([DOM_SECRET, 0x7, 0x1e57], 3);
    assert_eq(c, 0x171d8aba83de44e6d9f8e5905209506f8fe1dd28a8c8748bc8c831ccbcc670a);
}

#[test]
fn ticket_nullifier_matches_miner_core() {
    assert_eq(Poseidon2::hash([DOM_NULL, 0x12cb314d627cf48385b808837c1ca594af5820a308c1447aec7bcac0a80befbd], 2), 0x2347d500f7b7dd28f74b014cd3a6ecbe009a047619d2c5b53ba8d17b3b7d4c5f);
}

#[test]
fn next_seed_matches_miner_core() {
    let s = Poseidon2::hash(
        [DOM_SEED, 0x5, 0x1, 0x12cb314d627cf48385b808837c1ca594af5820a308c1447aec7bcac0a80befbd, 0x64],
        5,
    );
    assert_eq(s, 0x1bbeae9900bf96b3b0cbb6e7a9bf561a8f36dc6e4ea5d86d5804ac011939f184);
}

#[test]
fn retarget_matches_miner_core() {
    assert_eq(next_target(0x400000000000000000000000003039, 0x133), 0x417e4b17e4b17e4b17e4b17e4b493d);
}
